<script>
// ── State ──
const matrixLabels = [
  ['매우 유머러스','유머러스','중립','진지한','매우 진지한'],
  ['매우 비격식적','비격식적','중립','격식적','매우 격식적'],
  ['매우 대담한','대담한','중립','존중하는','매우 존중하는'],
  ['매우 열정적','열정적','중립','사실적','매우 사실적']
];

let voiceChartHTML = '';
let voiceChartData = [];
let guideData = null;
let checkHistory = [];
let currentStep = 1;
const maxStep = 5;

// ── Init ──
updateMatrix();
document.querySelectorAll('.trait-opt').forEach(opt => {
  opt.addEventListener('click', () => {
    const name = opt.querySelector('input').name;
    document.querySelectorAll(`input[name="${name}"]`).forEach(r => {
      r.closest('.trait-opt').classList.remove('selected');
    });
    opt.classList.add('selected');
    opt.querySelector('input').checked = true;
  });
});

function updateMatrix() {
  for (let i = 1; i <= 4; i++) {
    const v = parseInt(document.getElementById('m'+i).value);
    document.getElementById('mv'+i).textContent = matrixLabels[i-1][v-1];
  }
}

// ── Navigation ──
function goStep(n) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.getElementById('panel'+n).classList.add('active');

  document.querySelectorAll('.nav-item').forEach((item, i) => {
    item.classList.remove('active');
    if (i+1 < n) { item.classList.add('done'); document.getElementById('nc'+(i+1)).textContent = '✓'; }
    else if (i+1 === n) { item.classList.add('active'); document.getElementById('nc'+(i+1)).textContent = ''; }
    else { item.classList.remove('done'); document.getElementById('nc'+(i+1)).textContent = ''; }
  });

  document.querySelectorAll('.step-pip').forEach((pip, i) => {
    pip.classList.remove('active', 'done');
    if (i+1 < n) pip.classList.add('done');
    else if (i+1 === n) pip.classList.add('active');
  });

  document.getElementById('heroSection').style.display = n === 1 ? 'block' : 'none';
  currentStep = n;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function nextStep(from) {
  if (from === 1) {
    const name = document.getElementById('productName').value.trim();
    if (!name) { showNotif('서비스명을 입력해주세요.'); return; }
    const traits = getTraits();
    if (Object.values(traits).some(v => v === '미선택')) {
      showNotif('모든 브랜드 성격 항목을 선택해주세요.');
      return;
    }
    goStep(2);
  } else if (from === 2) {
    goStep(3);
    await generateVoiceChart();
  } else if (from === 3) {
    goStep(4);
    await generateGuide();
  } else if (from === 4) {
    goStep(5);
    renderCheckTags();
  }
}

// ── Data Helpers ──
function getTraits() {
  const groups = ['energy','warmth','style','authority','innovation','value'];
  const traits = {};
  groups.forEach(g => {
    const sel = document.querySelector(`input[name="${g}"]:checked`);
    traits[g] = sel ? sel.value : '미선택';
  });
  return traits;
}

function getMatrix() {
  return {
    funny: matrixLabels[0][parseInt(document.getElementById('m1').value)-1],
    formal: matrixLabels[1][parseInt(document.getElementById('m2').value)-1],
    respect: matrixLabels[2][parseInt(document.getElementById('m3').value)-1],
    enthusiasm: matrixLabels[3][parseInt(document.getElementById('m4').value)-1]
  };
}

// ── Claude API ──
async function callClaude(prompt, maxTok = 1200) {
  const resp = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: maxTok,
      messages: [{ role: 'user', content: prompt }]
    })
  });
  const data = await resp.json();
  return data.content[0].text;
}

// ── Generate Voice Chart ──
async function generateVoiceChart() {
  const name = document.getElementById('productName').value || '서비스';
  const desc = document.getElementById('productDesc').value || '';
  const t = getTraits();
  const m = getMatrix();

  const prompt = `당신은 UX 라이팅 전문가입니다. 아래 정보를 바탕으로 Torrey Podmajersky의 「전략적 UX 라이팅」 보이스 차트를 JSON으로 만들어주세요.

서비스: ${name}${desc ? ' ('+desc+')' : ''}
브랜드 성격: 에너지(${t.energy}), 친근함(${t.warmth}), 커뮤니케이션(${t.style}), 권위(${t.authority}), 혁신성(${t.innovation}), 가치(${t.value})
NNG 보이스 매트릭스: ${m.funny}, ${m.formal}, ${m.respect}, ${m.enthusiasm}

JSON 배열만 출력 (마크다운, 설명 절대 없이):
[
  {"trait":"에너지 레벨","identity":"내용","do":"내용","dont":"내용"},
  {"trait":"친근함","identity":"내용","do":"내용","dont":"내용"},
  {"trait":"커뮤니케이션 방식","identity":"내용","do":"내용","dont":"내용"},
  {"trait":"권위 수준","identity":"내용","do":"내용","dont":"내용"},
  {"trait":"혁신성","identity":"내용","do":"내용","dont":"내용"},
  {"trait":"가치 강조","identity":"내용","do":"내용","dont":"내용"}
]`;

  try {
    const result = await callClaude(prompt, 1800);
    const clean = result.replace(/^```[\w]*\n?/,'').replace(/\n?```$/,'').trim();
    const rows = JSON.parse(clean);
    voiceChartData = rows;
    renderEditableVoiceChart(rows);
    document.getElementById('vchart-btns').style.display = 'flex';
  } catch(e) {
    document.getElementById('vchart-area').innerHTML = `<div class="empty-state"><div class="empty-icon">⚠</div><div class="empty-text">생성 중 오류가 발생했습니다. 다시 시도해주세요.</div></div>`;
  }
}

function renderEditableVoiceChart(rows) {
  const editNote = `<p style="font-size:12px;color:var(--ink-3);margin-bottom:10px;display:flex;align-items:center;gap:6px;">
    <span style="background:var(--mint-light);color:var(--mint);padding:2px 8px;border-radius:100px;font-weight:500;font-size:11px;">편집 가능</span>
    셀을 클릭하면 직접 내용을 수정할 수 있습니다.
  </p>`;
  const thead = `<thead><tr>
    <th style="width:14%">성격 특성</th>
    <th style="width:29%">이런 브랜드입니다</th>
    <th style="width:29%">이렇게 씁니다</th>
    <th style="width:29%">이렇게 쓰지 않습니다</th>
  </tr></thead>`;
  const tbody = rows.map((r, i) => `<tr>
    <td style="font-weight:500;color:var(--ink)">${r.trait}</td>
    <td contenteditable="true" class="vc-editable" data-row="${i}" data-col="identity">${r.identity}</td>
    <td contenteditable="true" class="vc-editable" data-row="${i}" data-col="do">${r.do}</td>
    <td contenteditable="true" class="vc-editable" data-row="${i}" data-col="dont">${r.dont}</td>
  </tr>`).join('');
  document.getElementById('vchart-area').innerHTML = editNote + `<div class="vc-table-wrap"><table class="vc-table">${thead}<tbody>${tbody}</tbody></table></div>`;

  document.querySelectorAll('.vc-editable').forEach(cell => {
    cell.addEventListener('input', () => {
      const row = parseInt(cell.dataset.row);
      const col = cell.dataset.col;
      voiceChartData[row][col] = cell.textContent;
    });
  });
}

// ── Generate Guide ──
async function generateGuide() {
  const name = document.getElementById('productName').value || '서비스';
  const desc = document.getElementById('productDesc').value || '';
  const t = getTraits();
  const m = getMatrix();

  const prompt = `당신은 UX 라이팅 전문가입니다. 아래 정보로 실무 UX 라이팅 가이드를 작성하세요.

서비스: ${name}${desc ? ' ('+desc+')' : ''}
브랜드 성격: ${Object.values(t).join(', ')}
NNG 톤: ${Object.values(m).join(', ')}

아래 JSON만 출력 (마크다운 없이):
{
  "summary": "3줄 이내 핵심 보이스 요약 (문단)",
  "principles": ["핵심 원칙 1", "핵심 원칙 2", "핵심 원칙 3", "핵심 원칙 4"],
  "do": ["이렇게 씁니다 1", "이렇게 씁니다 2", "이렇게 씁니다 3", "이렇게 씁니다 4", "이렇게 씁니다 5"],
  "dont": ["이렇게 쓰지 않습니다 1", "이렇게 쓰지 않습니다 2", "이렇게 쓰지 않습니다 3", "이렇게 쓰지 않습니다 4", "이렇게 쓰지 않습니다 5"],
  "examples": [
    {"bad": "나쁜 예시 문장", "good": "좋은 예시 문장", "reason": "이유 한 줄"},
    {"bad": "나쁜 예시 문장2", "good": "좋은 예시 문장2", "reason": "이유2"},
    {"bad": "나쁜 예시 문장3", "good": "좋은 예시 문장3", "reason": "이유3"}
  ]
}`;

  try {
    const result = await callClaude(prompt, 2000);
    const jsonMatch = result.match(/\[?\{[\s\S]*\}\]?/);
    const clean = jsonMatch ? jsonMatch[0] : result.replace(/^```[\w]*\n?/,'').replace(/\n?```$/,'').trim();
    guideData = JSON.parse(clean);
    renderGuide(guideData);
    document.getElementById('guide-btns').style.display = 'flex';
  } catch(e) {
    document.getElementById('guide-area').innerHTML = `<div class="empty-state"><div class="empty-icon">⚠</div><div class="empty-text">생성 중 오류가 발생했습니다. 이전 단계를 확인 후 다시 시도해주세요.</div></div>`;
  }
}

function renderGuide(data) {
  const html = `
    <div class="guide-card-full" style="margin-bottom:1rem">
      <div class="guide-card-label">보이스 요약</div>
      <p class="guide-summary">"${data.summary}"</p>
    </div>
    <div class="guide-card-full" style="margin-bottom:1rem">
      <div class="guide-card-label">핵심 원칙</div>
      <ul class="principle-list">
        ${data.principles.map((p,i)=>`<li class="principle-item"><span class="principle-num">${i+1}</span><span>${p}</span></li>`).join('')}
      </ul>
    </div>
    <div class="guide-grid">
      <div class="guide-card do-card">
        <div class="guide-card-label">✓ 이렇게 씁니다</div>
        <div class="guide-card-body">${data.do.map(d=>`• ${d}`).join('\n')}</div>
      </div>
      <div class="guide-card dont-card">
        <div class="guide-card-label">✗ 이렇게 쓰지 않습니다</div>
        <div class="guide-card-body">${data.dont.map(d=>`• ${d}`).join('\n')}</div>
      </div>
    </div>
    <div class="guide-card-full">
      <div class="guide-card-label">예시 비교</div>
      ${data.examples.map(ex=>`
        <div class="example-row">
          <div class="example-bad">✗ ${ex.bad}</div>
          <div class="example-good">✓ ${ex.good}</div>
          <div class="example-reason">${ex.reason}</div>
        </div>
      `).join('')}
    </div>
  `;
  document.getElementById('guide-area').innerHTML = html;
}

function renderCheckTags() {
  if (!guideData) return;
  const t = getTraits();
  const name = document.getElementById('productName').value;
  const tags = [name, ...Object.values(t).slice(0,3)].filter(Boolean);
  document.getElementById('checkTags').innerHTML = tags.map(tag=>`<span class="check-tag">${tag}</span>`).join('');
}

// ── Run Check ──
async function runCheck() {
  const text = document.getElementById('checkText').value.trim();
  if (!text) { showNotif('검수할 문장을 입력해주세요.'); return; }
  if (!guideData) { showNotif('가이드를 먼저 완성해주세요.'); return; }

  const name = document.getElementById('productName').value || '서비스';
  const t = getTraits();
  const m = getMatrix();

  const resultEl = document.getElementById('check-result');
  resultEl.innerHTML = `<div class="loading-state" style="padding:2rem 0"><div class="loading-spinner"></div>검수 중...</div>`;

  const prompt = `당신은 UX 라이팅 검수 전문가입니다.

서비스: ${name}
브랜드 성격: ${Object.values(t).join(', ')}
NNG 톤: ${Object.values(m).join(', ')}
핵심 원칙: ${guideData.principles.join(' / ')}
써야 할 것: ${guideData.do.join(' / ')}
쓰지 말 것: ${guideData.dont.join(' / ')}

검수 대상: "${text}"

JSON만 출력 (마크다운 없이):
{
  "pass": true 또는 false,
  "score": 1~5,
  "summary": "한 줄 판단",
  "issues": ["문제점1", "문제점2"],
  "suggestion": "개선 제안 문장 (pass false일 때)"
}`;

  try {
    const result = await callClaude(prompt, 600);
    const clean = result.replace(/```json|```/g,'').trim();
    const data = JSON.parse(clean);
    renderCheckResult(data, text);
    checkHistory.unshift({ text, data, time: new Date() });
    if (checkHistory.length > 5) checkHistory.pop();
    renderHistory();
  } catch(e) {
    resultEl.innerHTML = `<div class="empty-state"><div class="empty-text">검수 중 오류가 발생했습니다.</div></div>`;
  }
}

function renderCheckResult(data, original) {
  const cls = data.pass ? 'pass' : 'fail';
  const verdict = data.pass ? '✓ 가이드 부합' : '✗ 가이드 미부합';
  const stars = '★'.repeat(data.score) + '☆'.repeat(5-data.score);
  let html = `<div class="result-card ${cls}">
    <div class="result-card-header">
      <span class="result-verdict">${verdict}</span>
      <span class="result-stars">${stars} ${data.score}/5</span>
    </div>
    <div class="result-body">
      <div class="result-summary">${data.summary}</div>`;
  if (data.issues && data.issues.length) {
    html += `<div class="result-issues">${data.issues.map(i=>`<div class="result-issue">• ${i}</div>`).join('')}</div>`;
  }
  if (!data.pass && data.suggestion) {
    html += `<div class="result-suggest-label">개선 제안</div><div class="result-suggest">"${data.suggestion}"</div>`;
  }
  html += `</div></div>`;
  document.getElementById('check-result').innerHTML = html;
}

function renderHistory() {
  if (checkHistory.length < 2) return;
  const items = checkHistory.slice(1).map(item => {
    const cls = item.data.pass ? 'pass' : 'fail';
    const dot = item.data.pass ? '✓' : '✗';
    return `<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px">
      <span style="color:${item.data.pass?'var(--mint)':'var(--red)'};font-weight:600;flex-shrink:0">${dot}</span>
      <span style="color:var(--ink-2);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${item.text}</span>
      <span style="color:var(--ink-3);flex-shrink:0">${item.data.score}/5</span>
    </div>`;
  }).join('');
  document.getElementById('check-history').innerHTML = `
    <div style="font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-3);margin-bottom:8px">이전 검수 기록</div>
    ${items}
  `;
}

// ── Notification ──
function showNotif(msg) {
  const el = document.getElementById('notif');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2500);
}
</script>

